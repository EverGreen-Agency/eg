# Copie para .env e preencha. Nenhuma destas variaveis e obrigatoria para o
# build passar — o site degrada com fallback em todas elas.

# WordPress headless: fonte do /blog e da /autoridade.
NEXT_PUBLIC_WORDPRESS_API_URL=

# Envio do formulario de /contato.
RESEND_API_KEY=

# Pixel do Meta. Fica desligado na rota imersiva /growth por decisao de produto.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Endpoint publico do Bioma que alimenta a /benchmark.
NEXT_PUBLIC_BIOMA_BENCHMARK_URL=

# Container do Google Tag Manager. Sem isto, os eventos que a /growth empurra
# para window.dataLayer (presentation_started, section_viewed, case_viewed,
# whatsapp_clicked, presentation_completed...) nao chegam a lugar nenhum.
# O GTM so carrega depois do aceite no banner de cookies.
NEXT_PUBLIC_GTM_ID=

# Destino do CTA principal da /growth. Opcional: sem ela o botao usa o wa.me
# padrao definido em src/app/growth/GrowthExperience.tsx, com texto por idioma.
# Serve para trocar numero ou mensagem sem deploy.
NEXT_PUBLIC_EG_WHATSAPP_URL=
